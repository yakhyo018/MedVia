{
	"name": "medvia",
	"version": "0.0.1",
	"description": "MedVia - medical tourism booking platform",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build && nest build medvia-batch",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:dev:batch": "nest start medvia-batch --watch",
		"start:prod": "NODE_ENV=production node dist/apps/medvia-api/main",
		"start:prod:batch": "NODE_ENV=production node dist/apps/medvia-batch/main",
		"typecheck": "tsc -p apps/medvia-api/tsconfig.json && tsc -p apps/medvia-batch/tsconfig.app.json --noEmit",
		"lint:check": "eslint \"apps/**/*.ts\"",
		"lint:fix": "eslint \"apps/**/*.ts\" --fix",
		"format": "prettier --write \"apps/**/*.ts\"",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:api": "node postman/run.js",
		"test:socket": "node postman/socket.js",
		"seed:admin": "ts-node -P apps/medvia-api/tsconfig.app.json apps/medvia-api/src/scripts/seed-admin.ts",
		"eval:translate": "ts-node -P apps/medvia-api/tsconfig.app.json apps/medvia-api/src/scripts/eval-translate.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.132.1",
		"@apollo/server": "^4.11.3",
		"@nestjs/apollo": "^12.2.2",
		"@nestjs/common": "^10.4.15",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.4.15",
		"@nestjs/graphql": "^12.2.2",
		"@nestjs/jwt": "^10.2.0",
		"@nestjs/mongoose": "^10.1.0",
		"@nestjs/platform-express": "^10.4.15",
		"@nestjs/platform-socket.io": "^10.4.22",
		"@nestjs/schedule": "^4.1.2",
		"@nestjs/throttler": "^6.7.1",
		"@nestjs/websockets": "^10.4.22",
		"bcryptjs": "^3.0.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.7",
		"dotenv": "^16.4.7",
		"google-auth-library": "^9.15.1",
		"graphql": "^16.10.0",
		"ioredis": "^5.4.2",
		"joi": "^17.13.3",
		"mongoose": "^8.9.5",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^10.4.9",
		"@nestjs/schematics": "^10.2.3",
		"@nestjs/testing": "^10.4.15",
		"@types/cookie-parser": "^1.4.10",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.6",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.2.1",
		"globals": "^15.14.0",
		"jest": "^29.7.0",
		"js-yaml": "^4.3.2",
		"newman": "^6.2.2",
		"prettier": "^3.4.2",
		"socket.io-client": "^4.8.4",
		"source-map-support": "^0.5.21",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"roots": [
			"<rootDir>/apps/"
		]
	}
}
