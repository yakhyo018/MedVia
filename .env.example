# Copy to .env and fill in. .env is git-ignored and never shared.
NODE_ENV=development

PORT_API=3000
PORT_BATCH=3001

# MongoDB Atlas. Atlas gives a replica set, which is what makes transactions work.
MONGO_DEV=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medvia_dev?retryWrites=true&w=majority
MONGO_PROD=

# Local: redis://localhost:6379   Cloud (Upstash): rediss://...
REDIS_URL=redis://localhost:6379

# JWT signing secret, at least 16 characters. Generate: openssl rand -base64 32
SECRET_TOKEN=

# The only browser origin allowed to send the refresh cookie. Comma-separate several.
# The frontend runs on 4000 because the API already takes 3000.
FRONTEND_URL=http://localhost:4000

# The one ADMIN account, created by `npm run seed:admin` (signup can never create one).
# `npm run test:api` also reads these to sign in as admin. Password: at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# `npm run seed:demo`: the password of every demo account (<name>@seed.medvia.test). Never in production.
SEED_PASSWORD=

# Google sign-in: OAuth client id from Google Cloud Console. Empty = Google sign-in disabled.
GOOGLE_CLIENT_ID=

# Atlas Search index on `clinics` (created once from docs/atlas-search/clinics.json).
# Empty = clinic text search uses a regex on the names instead.
ATLAS_SEARCH_INDEX=

# AES-256 key for booking questionnaires: 32 random bytes, base64. Required.
# Generate once: openssl rand -base64 32   Keep a copy — losing it makes questionnaires unreadable.
MEDICAL_ENC_KEY=

# true = register the Postman-only test helpers (moving a booking into the past for the M6
# review tests). Never registered when NODE_ENV=production, whatever this says.
ENABLE_TEST_SUPPORT=

# AI translation and questionnaire summary.
#   fake        default — deterministic "[KO] text", free; Jest and Postman run on it
#   openrouter  demo with synthetic data; free endpoints may log prompts — refused in production
#   anthropic   production; refused without ANTHROPIC_API_KEY
AI_PROVIDER=fake
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# openrouter: the model id is required (pick it with `npm run eval:translate`).
# anthropic: defaults to claude-haiku-4-5 (chat) and claude-opus-5-5 (summary).
AI_MODEL_TRANSLATE=
AI_MODEL_SUMMARY=
# The booking assistant (AI-2): a model with tool calling. OpenRouter: a free model whose
# parameters list `tools` — pick it with `npm run eval:assistant`. Anthropic default: claude-opus-5-5.
AI_MODEL_ASSISTANT=
