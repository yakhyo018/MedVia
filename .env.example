# Copy to .env and fill in. .env is git-ignored and never shared.
NODE_ENV=development

PORT_API=3000
PORT_BATCH=3001

# MongoDB Atlas. Atlas gives a replica set, which is what makes transactions work.
MONGO_DEV=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medvia_dev?retryWrites=true&w=majority
MONGO_PROD=

# Local: redis://localhost:6379   Cloud (Upstash): rediss://...
REDIS_URL=redis://localhost:6379

# JWT signing secret, at least 16 characters. Generate: openssl rand -base64 32
SECRET_TOKEN=

# The only browser origin allowed to send the refresh cookie. Comma-separate several.
# The frontend runs on 4000 because the API already takes 3000.
FRONTEND_URL=http://localhost:4000

# The one ADMIN account, created by `npm run seed:admin` (signup can never create one).
# `npm run test:api` also reads these to sign in as admin. Password: at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google sign-in: OAuth client id from Google Cloud Console. Empty = Google sign-in disabled.
GOOGLE_CLIENT_ID=

# Atlas Search index on `clinics` (created once from docs/atlas-search/clinics.json).
# Empty = clinic text search uses a regex on the names instead.
ATLAS_SEARCH_INDEX=

# AES-256 key for booking questionnaires: 32 random bytes, base64. Required.
# Generate once: openssl rand -base64 32   Keep a copy — losing it makes questionnaires unreadable.
MEDICAL_ENC_KEY=
